# Server port for the API
PORT=3001
# City used for weather when the browser doesn't send one
DEFAULT_CITY=Berlin

# Supabase (tasks storage). Leave empty to keep tasks in memory.
# Project settings → API keys. Use a SECRET key (sb_secret_...), not the publishable one:
# it is only ever read by the server and never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
